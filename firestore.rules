rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un joueur ne peut lire / modifier que SON propre compte.
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'code', 'solde', 'cree', 'vu'])
        && request.resource.data.solde is number
        && request.resource.data.solde >= 0;

      // Seuls le solde et la date de dernière visite peuvent changer (id et code sont verrouillés).
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solde', 'vu'])
        && request.resource.data.solde is number
        && request.resource.data.solde >= 0;

      allow delete: if false;
    }
  }
}
